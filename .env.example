# Local development credentials for the Postgres + pgAdmin containers.
# They are only reachable on this machine via docker compose.
POSTGRES_DB=guazi
POSTGRES_USER=guazi
POSTGRES_PASSWORD=change-me


# host ports
PG_PORT=55432
VNC_PORT=6080

# parser
TARGET_CARS=150
CITY=bin
MAX_IMAGES_PER_CAR=40
CONCURRENCY=4

# Yandex Object Storage (S3-compatible) — photo upload target
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ru-central1
AWS_ENDPOINT_URL=https://storage.yandexcloud.net
S3_BUCKET=cargo-auto
S3_PREFIX=guazi/images

# Production deployment (make prod)
DOMAIN=
ACME_EMAIL=
# Roubles shown on the storefront are converted from the source USD price with
# this rate. Leave at 0 to display the source prices in USD instead.
USD_RUB_RATE=0
CORS_ORIGINS=*
