# Rendered at container start: ${DOMAIN} is substituted, nginx's own $variables
# are left alone (envsubst is given an explicit variable list).

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Let's Encrypt HTTP-01 challenge. Must stay on plain HTTP and must not be
    # redirected, or renewal fails.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    # Validated pair published before startup; no self-signed fallback.
    ssl_certificate     ${CERT_DIR}/fullchain.pem;
    ssl_certificate_key ${CERT_DIR}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling ${STAPLING};
    ssl_stapling_verify ${STAPLING};

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    server_tokens off;

    gzip on;
    # everything here is proxied from the API, and nginx leaves proxied
    # responses uncompressed unless told otherwise
    gzip_proxied any;
    gzip_vary on;
    # text/javascript is what the API actually sends for .js; listing only
    # application/javascript silently left scripts uncompressed
    gzip_types text/plain text/css text/javascript text/xml
               application/javascript application/json application/xml
               image/svg+xml;
    gzip_min_length 1024;

    client_max_body_size 4m;

    # Docker's embedded DNS. Naming the upstream through a variable defers
    # resolution to request time: nginx no longer refuses to start when the API
    # container is not up yet, and it follows the API to a new address after a
    # restart instead of serving a stale one.
    resolver ${RESOLVER} valid=10s ipv6=off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        set $upstream_api http://api:8000;
        proxy_pass $upstream_api$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 60s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    error_page 502 503 504 =503 /__unavailable.html;
    location = /__unavailable.html {
        internal;
        default_type text/html;
        return 503 '<!doctype html><meta charset="utf-8"><title>Сервис недоступен</title><p>Каталог временно недоступен. Обновите страницу через минуту.';
    }
}
